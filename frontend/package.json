{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start":    "vite",
    "test":     "vitest run --dir test/unitario",
    "pree2e": "pnpm run db",
    "e2e":      "playwright test test/e2e",
    "poste2e": "pnpm run db",
    "pree2e-ui": "pnpm run db",
    "e2e-ui":   "playwright test test/e2e --ui",
    "poste2e-ui": "pnpm run db",
    "api":      "json-server  ../api/json-server/api.json",
    "db":       "pnpm run db-e && pnpm run db-d",
    "db-e":     "mysql -u root --password=\"\" < ../api/db/estrutura.sql",
    "db-d":     "mysql -u root --password=\"\" g2 < ../api/db/dados.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "json-server": "1.0.0-beta.3",
    "playwright": "^1.55.1",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}