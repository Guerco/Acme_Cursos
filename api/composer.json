{
    "name": "quiz/api",
    "description": "API para quiz",
    "type": "project",
    "license": "MIT",
    "scripts": {
        "api":  [
                    "Composer\\Config::disableProcessTimeout",
                    "php -S localhost:8080"
                ], 
        "test": "kahlan",
        "check": "phpstan analyze src --level=7",
        "db": [
            "@db-e",
            "@db-d"
        ],
        "db-e": "mysql -u root --password=\"\" < ./db/estrutura.sql",
        "db-d": "mysql -u root --password=\"\" g2 < ./db/dados.sql"
    },
    "autoload": {
        "psr-4": {
            "": [
                "src/config/",
                "src/model/",
                "src/model/dto/",
                "src/model/exception/",
                "src/model/repositorio/",
                "src/model/servico/",
                "src/model/validacao",
                "src/model/sessao"
            ]
        }
    },
    "authors": [
        {
            "name": "Guerco",
            "email": "gabrielszgrco@gmail.com"
        },
        {
            "name": "MychelleSatyn",
            "email": "mychellesatyn@gmail.com"
        }
    ],
    "require": {
        "phputil/router": "^0.3.6",
        "phputil/cors": "^0.5.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "kahlan/kahlan": "^6.0",
        "phpstan/phpstan": "^2.1"
    }
}
